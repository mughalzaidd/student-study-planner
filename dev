<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Study Planner</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f3f6fb;
            color: #222;
        }

        header {
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            color: white;
            text-align: center;
            padding: 45px 20px;
        }

        header h1 {
            font-size: 38px;
            margin-bottom: 10px;
        }

        header p {
            font-size: 17px;
        }

        .container {
            width: 90%;
            max-width: 1100px;
            margin: 30px auto;
        }

        /* Dashboard */

        .dashboard {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 25px;
        }

        .stat {
            background: white;
            padding: 25px;
            text-align: center;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

        .stat .icon {
            font-size: 30px;
        }

        .stat h2 {
            color: #4f46e5;
            margin: 8px 0;
            font-size: 30px;
        }

        .stat p {
            color: #666;
        }

        /* Cards */

        .card {
            background: white;
            padding: 30px;
            margin-bottom: 25px;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.07);
        }

        .card h2 {
            margin-bottom: 20px;
        }

        /* Form */

        label {
            display: block;
            font-weight: bold;
            margin-bottom: 7px;
        }

        input,
        select {
            width: 100%;
            padding: 12px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 15px;
            margin-bottom: 18px;
        }

        input:focus,
        select:focus {
            outline: none;
            border-color: #4f46e5;
        }

        .form-row {
            display: flex;
            gap: 20px;
        }

        .form-row > div {
            flex: 1;
        }

        button {
            border: none;
            border-radius: 8px;
            padding: 11px 18px;
            cursor: pointer;
            font-size: 15px;
        }

        .add-btn {
            background: #4f46e5;
            color: white;
            width: 100%;
            font-size: 16px;
        }

        .add-btn:hover {
            background: #3730a3;
        }

        /* Task section */

        .task-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
        }

        .task-header select {
            width: 180px;
            margin: 0;
        }

        .task-list {
            margin-top: 20px;
        }

        .task {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #f8fafc;
            border-left: 5px solid #4f46e5;
            padding: 17px;
            margin-bottom: 12px;
            border-radius: 8px;
        }

        .task.completed {
            border-left-color: #22c55e;
            opacity: 0.65;
        }

        .task.completed h3 {
            text-decoration: line-through;
        }

        .task-info h3 {
            margin-bottom: 5px;
        }

        .task-info p {
            color: #666;
            font-size: 14px;
        }

        .actions {
            display: flex;
            gap: 8px;
        }

        .complete-btn {
            background: #22c55e;
            color: white;
        }

        .delete-btn {
            background: #ef4444;
            color: white;
        }

        .empty {
            text-align: center;
            color: #777;
            padding: 25px;
        }

        /* Weekly schedule */

        .schedule {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }

        .day {
            background: #f8fafc;
            border-top: 4px solid #7c3aed;
            border-radius: 10px;
            padding: 18px;
        }

        .day h3 {
            color: #4f46e5;
            margin-bottom: 8px;
        }

        .day p {
            font-weight: bold;
            margin-bottom: 5px;
        }

        .day small {
            color: #666;
        }

        /* Tips */

        .tips li {
            margin: 10px 0;
        }

        /* Footer */

        footer {
            background: #111827;
            color: white;
            text-align: center;
            padding: 25px;
            margin-top: 40px;
        }

        /* Mobile */

        @media (max-width: 800px) {
            .dashboard {
                grid-template-columns: repeat(2, 1fr);
            }

            .schedule {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 550px) {
            header h1 {
                font-size: 28px;
            }

            .dashboard {
                grid-template-columns: 1fr;
            }

            .form-row {
                flex-direction: column;
                gap: 0;
            }

            .schedule {
                grid-template-columns: 1fr;
            }

            .task-header {
                flex-direction: column;
                align-items: stretch;
            }

            .task-header select {
                width: 100%;
            }

            .task {
                flex-direction: column;
                align-items: stretch;
                gap: 15px;
            }

            .actions {
                justify-content: flex-end;
            }
        }
    </style>
</head>

<body>

<header>
    <h1>📚 Student Study Planner</h1>
    <p>Plan your studies, complete your tasks and track your progress.</p>
</header>

<div class="container">

    <!-- Dashboard -->
    <section class="dashboard">

        <div class="stat">
            <div class="icon">📋</div>
            <h2 id="total">0</h2>
            <p>Total Tasks</p>
        </div>

        <div class="stat">
            <div class="icon">✅</div>
            <h2 id="completed">0</h2>
            <p>Completed</p>
        </div>

        <div class="stat">
            <div class="icon">⏳</div>
            <h2 id="pending">0</h2>
            <p>Pending</p>
        </div>

        <div class="stat">
            <div class="icon">📈</div>
            <h2 id="progress">0%</h2>
            <p>Progress</p>
        </div>

    </section>


    <!-- Add Task -->
    <section class="card">

        <h2>➕ Add Study Task</h2>

        <form id="taskForm">

            <label for="taskName">Task Name</label>
            <input
                type="text"
                id="taskName"
                placeholder="Example: Complete Mathematics Chapter 5"
                required
            >

            <div class="form-row">

                <div>
                    <label for="subject">Subject</label>

                    <select id="subject" required>
                        <option value="">Select Subject</option>
                        <option>Mathematics</option>
                        <option>Science</option>
                        <option>English</option>
                        <option>Social Studies</option>
                        <option>Computer Science</option>
                        <option>Other</option>
                    </select>
                </div>

                <div>
                    <label for="date">Date</label>
                    <input type="date" id="date" required>
                </div>

            </div>

            <button class="add-btn" type="submit">
                ➕ Add Study Task
            </button>

        </form>

    </section>


    <!-- Tasks -->
    <section class="card">

        <div class="task-header">

            <h2>📝 My Study Tasks</h2>

            <select id="filter">
                <option value="all">All Tasks</option>
                <option value="pending">Pending</option>
                <option value="completed">Completed</option>
            </select>

        </div>

        <div id="taskList" class="task-list"></div>

    </section>


    <!-- Weekly Plan -->
    <section class="card">

        <h2>📅 Weekly Study Plan</h2>

        <div class="schedule">

            <div class="day">
                <h3>Monday</h3>
                <p>Mathematics</p>
                <small>5:00 PM - 6:00 PM</small>
            </div>

            <div class="day">
                <h3>Tuesday</h3>
                <p>Science</p>
                <small>5:00 PM - 6:00 PM</small>
            </div>

            <div class="day">
                <h3>Wednesday</h3>
                <p>English</p>
                <small>5:00 PM - 6:00 PM</small>
            </div>

            <div class="day">
                <h3>Thursday</h3>
                <p>Social Studies</p>
                <small>5:00 PM - 6:00 PM</small>
            </div>

            <div class="day">
                <h3>Friday</h3>
                <p>Computer Science</p>
                <small>5:00 PM - 6:00 PM</small>
            </div>

            <div class="day">
                <h3>Saturday</h3>
                <p>Weekly Revision</p>
                <small>10:00 AM - 12:00 PM</small>
            </div>

            <div class="day">
                <h3>Sunday</h3>
                <p>Practice Test</p>
                <small>10:00 AM - 11:00 AM</small>
            </div>

        </div>

    </section>


    <!-- Study Tips -->
    <section class="card tips">

        <h2>💡 Study Tips</h2>

        <ul>
            <li>Study for 45–60 minutes and take short breaks.</li>
            <li>Revise your lessons regularly.</li>
            <li>Practice questions instead of only reading.</li>
            <li>Keep your phone away while studying.</li>
            <li>Get enough sleep before examinations.</li>
        </ul>

    </section>

</div>


<footer>
    <p>© 2026 Student Study Planner | Made for Students 🎓</p>
</footer>


<script>

    // Get saved tasks from browser storage
    let tasks = JSON.parse(localStorage.getItem("studyTasks")) || [];


    // Elements
    const form = document.getElementById("taskForm");
    const taskList = document.getElementById("taskList");
    const filter = document.getElementById("filter");

    const total = document.getElementById("total");
    const completed = document.getElementById("completed");
    const pending = document.getElementById("pending");
    const progress = document.getElementById("progress");

    const dateInput = document.getElementById("date");


    // Set today's date
    const today = new Date().toISOString().split("T")[0];

    dateInput.value = today;


    // Add task
    form.addEventListener("submit", function(event) {

        event.preventDefault();

        const taskName =
            document.getElementById("taskName").value.trim();

        const subject =
            document.getElementById("subject").value;

        const date =
            document.getElementById("date").value;


        if (!taskName || !subject || !date) {
            alert("Please fill in all fields.");
            return;
        }


        const newTask = {

            id: Date.now(),

            name: taskName,

            subject: subject,

            date: date,

            completed: false

        };


        tasks.push(newTask);

        saveTasks();

        displayTasks();

        updateStats();


        form.reset();

        dateInput.value = today;

    });


    // Filter tasks
    filter.addEventListener("change", function() {

        displayTasks();

    });


    // Display tasks
    function displayTasks() {

        taskList.innerHTML = "";


        let filteredTasks = tasks;


        if (filter.value === "pending") {

            filteredTasks =
                tasks.filter(task => !task.completed);

        }


        if (filter.value === "completed") {

            filteredTasks =
                tasks.filter(task => task.completed);

        }


        if (filteredTasks.length === 0) {

            taskList.innerHTML =
                `<div class="empty">
                    No tasks found. Add a study task!
                </div>`;

            return;
        }


        filteredTasks.forEach(task => {

            const taskElement =
                document.createElement("div");


            taskElement.className =
                "task " +
                (task.completed ? "completed" : "");


            taskElement.innerHTML = `

                <div class="task-info">

                    <h3>${escapeHTML(task.name)}</h3>

                    <p>
                        📚 ${escapeHTML(task.subject)}
                        &nbsp; | &nbsp;
                        📅 ${formatDate(task.date)}
                    </p>

                </div>

                <div class="actions">

                    <button
                        class="complete-btn"
                        onclick="toggleTask(${task.id})">

                        ${task.completed ? "↩ Undo" : "✓ Complete"}

                    </button>

                    <button
                        class="delete-btn"
                        onclick="deleteTask(${task.id})">

                        🗑 Delete

                    </button>

                </div>
            `;


            taskList.appendChild(taskElement);

        });

    }


    // Complete / undo task
    function toggleTask(id) {

        tasks = tasks.map(task => {

            if (task.id === id) {

                return {
                    ...task,
                    completed: !task.completed
                };

            }

            return task;

        });


        saveTasks();

        displayTasks();

        updateStats();

    }


    // Delete task
    function deleteTask(id) {

        const confirmDelete =
            confirm("Are you sure you want to delete this task?");


        if (!confirmDelete) {
            return;
        }


        tasks =
            tasks.filter(task => task.id !== id);


        saveTasks();

        displayTasks();

        updateStats();

    }


    // Update dashboard
    function updateStats() {

        const totalTasks = tasks.length;

        const completedTasks =
            tasks.filter(task => task.completed).length;

        const pendingTasks =
            totalTasks - completedTasks;


        let percentage = 0;


        if (totalTasks > 0) {

            percentage =
                Math.round(
                    (completedTasks / totalTasks) * 100
                );

        }


        total.textContent = totalTasks;

        completed.textContent = completedTasks;

        pending.textContent = pendingTasks;

        progress.textContent = percentage + "%";

    }


    // Save tasks
    function saveTasks() {

        localStorage.setItem(
            "studyTasks",
            JSON.stringify(tasks)
        );

    }


    // Format date
    function formatDate(dateString) {

        const date =
            new Date(dateString + "T00:00:00");


        return date.toLocaleDateString(
            "en-IN",
            {
                day: "2-digit",
                month: "short",
                year: "numeric"
            }
        );

    }


    // Prevent HTML injection
    function escapeHTML(value) {

        return value
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");

    }


    // Load tasks when page opens
    displayTasks();

    updateStats();

</script>

</body>
</html>
